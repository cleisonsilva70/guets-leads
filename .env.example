# Planilha do Google (cadastro, Round Robin e leitura do painel /admin)
# ver google-apps-script/Code.gs.
# URL do Web App publicado a partir da planilha (termina em /exec).
GOOGLE_SHEETS_WEBHOOK_URL=
# Mesmo valor salvo em Extensões > Apps Script > Propriedades do projeto > ADMIN_TOKEN.
GOOGLE_SHEETS_TOKEN=

# Admin (painel /admin)
ADMIN_PASSWORD=
# String aleatória longa, só para assinar o cookie de sessão do admin.
ADMIN_SESSION_SECRET=

# Tracking (opcional — sem eles os scripts simplesmente não carregam)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
# Meta Conversions API (server-side) — gerado em Gerenciador de Eventos >
# seu Pixel > Configurações > API de Conversões > Gerar token de acesso.
# Manda o mesmo evento "Lead" que o Pixel, deduplicado pelo leadId.
META_CONVERSIONS_API_TOKEN=
# Só em teste: código de "Testar eventos" do Gerenciador de Eventos, pra ver
# os eventos chegando ao vivo sem misturar com dados reais. Remover em prod.
META_TEST_EVENT_CODE=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Destinos usados nas telas de desqualificação do quiz
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/guetsfit
NEXT_PUBLIC_B2C_CATALOG_URL=
